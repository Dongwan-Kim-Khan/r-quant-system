# ==============================================================================
# AL-SANGMOO QUANT TERMINAL: PRODUCTION & STAGING ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# For C-2 Bundle Engine: Equal Sizing (34/33/33), Dual-Clock Stops (-7% EOD / -10% Emerg),
# +18% Uncapped Trailing (ATR 3.0), and QQQ Cash-Proxy Sleeve.
#
# INSTRUCTIONS:
#   1. Copy this file to .env: `cp .env.example .env`
#   2. Fill in your Korea Investment & Securities (한국투자증권) API credentials.
#   3. For Staging/Dry-Run: KEEP KIS_MODE=vps and KIS_PAPER_TRADING=true.
#   4. For Real Production Cutover: Set KIS_MODE=prod and KIS_PAPER_TRADING=false.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KIS (한국투자증권) OpenAPI Credentials & Trading Mode
# ------------------------------------------------------------------------------
# KIS OpenAPI App Key & Secret Key issued from KIS Developer Portal (https://apiportal.koreainvestment.com)
KIS_APP_KEY="YOUR_KIS_APP_KEY_HERE"
KIS_APP_SECRET="YOUR_KIS_APP_SECRET_HERE"

# KIS Account Number (8 digits CANO) & Account Product Code (2 digits, typically 01)
KIS_CANO="12345678"
KIS_ACNT_PRDT_CD="01"

# Trading Environment Mode:
#   - 'vps' (or 'paper', 'virtual', 'mock'): Routes to Virtual Sandbox (https://openapivts.koreainvestment.com:29443)
#   - 'prod' (or 'real'): Routes to Real Production Gateway (https://openapi.koreainvestment.com:9443)
# WARNING: NEVER switch to 'prod' until completing the Paper/VPS staging checklist in DEPLOYMENT_RUNBOOK_C2.md!
KIS_MODE="vps"
KIS_PAPER_TRADING="true"

# ------------------------------------------------------------------------------
# 2. Database & State Persistence
# ------------------------------------------------------------------------------
# SQLite DB path (defaults to quant_trades.db in project root).
# SQLite is configured with WAL mode and atomic PRAGMA synchronous=NORMAL.
AL_SANGMOO_DB_PATH="quant_trades.db"

# ------------------------------------------------------------------------------
# 3. Strategy & Portfolio Sizing (C-2 Bundle SSOT)
# ------------------------------------------------------------------------------
# Active engine designation (frozen champion C-2)
AL_SANGMOO_ENGINE="C-2"

# Cash-Proxy Idle Overlay:
#   - CASH_PROXY_TICKER: Core ETF for idle cash (default: QQQ)
#   - LEVERAGE_MODE: false (1.0x QQQ core overlay, strictly dominant per Track 1)
#                    true (1.5x gross dynamic QLD overlay when SPY >= 200MA & VIX < 20)
AL_SANGMOO_CASH_PROXY="QQQ"
AL_SANGMOO_LEVERAGE_MODE="false"

# ------------------------------------------------------------------------------
# 4. Service Orchestration & Daemon Polling Schedules
# ------------------------------------------------------------------------------
# Portfolio Guardian background loop interval (in seconds)
# Default is 10 seconds. In RTH, Guardian monitors emergency stops (-10.0%).
# In the EOD window (15:50-16:00 ET), Guardian executes EOD hard stops (-7.0%).
PORTFOLIO_GUARDIAN_INTERVAL="10"

# Timezone SSOT: Always America/New_York (handles US EDT/EST Daylight Saving Time automatically)
# DO NOT hardcode KST cron hours without DST conversion!
#   - US Summer (EDT): Closing window 15:50-16:00 ET = 04:50-05:00 KST (next morning)
#   - US Winter (EST): Closing window 15:50-16:00 ET = 05:50-06:00 KST (next morning)
#   - US Half-days: Closing window 12:50-13:00 ET (e.g., Dec 24, Jul 3, post-Thanksgiving)
MARKET_TIMEZONE="America/New_York"
EOD_WINDOW_MINUTES="10"

# ------------------------------------------------------------------------------
# 5. Web Terminal & API Server Settings
# ------------------------------------------------------------------------------
HOST="0.0.0.0"
PORT="8000"
DEBUG="false"

# ------------------------------------------------------------------------------
# 6. Notifications & Emergency Alerts (Optional)
# ------------------------------------------------------------------------------
# Slack Incoming Webhook URL for order fill / guardian stop notifications
SLACK_WEBHOOK_URL=""

# Telegram Bot Token & Chat ID for mobile emergency alerts
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
